<mujoco model="closed_chain_vertical">

    <compiler angle="radian" coordinate="local"/>
    <option timestep="0.001" gravity="0 0 -9.81" iterations="50"/>

    <visual>
        <map force="0.1" zfar="30"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global offwidth="2560" offheight="1440" elevation="-20" azimuth="120"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    </asset>

    <size njmax="1000" nconmax="200"/>

    <worldbody>
        <geom name="floor" size="0 0 .05" type="plane" material="grid" condim="3"/>
        <light name="spotlight" mode="targetbody" target="A" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="0 -6 4" cutoff="30"/>
        <light name="top" pos="0 0 2" mode="trackcom"/>

        <!-- 台架：底座 + 立柱 + 侧安装板 -->
        <body name="stand" pos="0 0 0">
            <!-- 底座 -->
            <geom name="stand_base" type="box" size="0.15 0.15 0.02" pos="0 0 0.02" rgba="0.3 0.3 0.3 1"/>
            <!-- 立柱（高 0.80 m） -->
            <geom name="stand_pole" type="cylinder" size="0.012 0.40" pos="0 0 0.42" rgba="0.4 0.4 0.4 1"/>
            <!-- 侧安装板（沿 Y 伸出，使连杆与立柱错开平面） -->
            <geom name="stand_arm" type="box" size="0.008 0.025 0.004" pos="0 0.037 0.80" rgba="0.5 0.5 0.5 1"/>
        </body>

        <!-- A 点固定在台架侧面，离地 0.80 m，沿 Y 偏移避免干涉 -->
        <body name="A" pos="0 0.065 0.80">
            <camera name="main" pos="-0.6 0 0.3" xyaxes="0 -1 0 1 0 1" mode="trackcom"/>
            <geom type="sphere" size="0.01"/>

            <!-- B branch：绕 Y 轴转，在 XZ 竖直平面内运动 -->
            <body name="B" pos="0 0 0">
                <joint name="q_B" type="hinge" axis="0 1 0" damping="0.2" frictionloss="0.01"/>
                <geom type="capsule" fromto="0 0 0 0.0945 0 0" size="0.01"/>

                <body name="BC" pos="0.0945 0 0">
                    <joint name="q_BC" type="hinge" axis="0 1 0" damping="0.2" frictionloss="0.01"/>
                    <geom type="capsule" fromto="0 0 0 0.1125 0 0" size="0.01"/>

                    <body name="C" pos="0.1125 0 0">
                        <joint name="q_C" type="hinge" axis="0 1 0" damping="0.2" frictionloss="0.01"/>
                        <geom type="capsule" fromto="0 0 0 0.116 0 0" size="0.01"/>
                        <site name="C_site" pos="0.116 0 0"/>
                    </body>
                </body>
            </body>

            <!-- D branch：绕 Y 轴转，在 XZ 竖直平面内运动 -->
            <body name="D" pos="0 0 0">
                <joint name="q_D" type="hinge" axis="0 1 0" damping="0.2" frictionloss="0.01"/>
                <geom type="capsule" fromto="0 0 0 0.090 0 0" size="0.01"/>
                <site name="D_site" pos="0.090 0 0"/>

                <geom type="capsule" fromto="0 0 0 0.210 0 0" size="0.006"/>
                <site name="G_site" pos="0.210 0 0"/>

                <body name="DE" pos="0.090 0 0">
                    <joint name="q_DE" type="hinge" axis="0 1 0" damping="0.2" frictionloss="0.01"/>
                    <geom type="capsule" fromto="0 0 0 0.060 0 0" size="0.01"/>
                    <site name="E_site" pos="0.060 0 0"/>

                    <body name="E" pos="0.060 0 0">
                        <joint name="q_E" type="hinge" axis="0 1 0" damping="0.2" frictionloss="0.01"/>
                        <geom type="capsule" fromto="0 0 0 0.120 0 0" size="0.01"/>
                        <site name="F_site" pos="0.120 0 0"/>

                        <body name="F" pos="0.120 0 0">
                            <joint name="q_F" type="hinge" axis="0 1 0" damping="0.2" frictionloss="0.01"/>
                            <geom type="capsule" fromto="0 0 0 0.060 0 0" size="0.01"/>

                            <body name="G_loop" pos="0.060 0 0">
                                <site name="G_loop_site" pos="0 0 0"/>
                                <geom type="capsule" fromto="0 0 0 0.250 0 0" size="0.008"/>
                                <site name="H_site" pos="0.250 0 0"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

        </body>

    </worldbody>

    <tendon>
        <fixed name="t_de_abs">
            <joint joint="q_D" coef="1"/>
            <joint joint="q_DE" coef="1"/>
        </fixed>
        <fixed name="t_dc_abs">
            <joint joint="q_B" coef="1"/>
            <joint joint="q_BC" coef="1"/>
            <joint joint="q_C" coef="1"/>
        </fixed>
    </tendon>

    <actuator>
        <position name="act_q_B" joint="q_B" kp="100" ctrlrange="-6.28 6.28"/>
        <position name="act_q_D" joint="q_D" kp="100" ctrlrange="-6.28 6.28"/>
    </actuator>

    <sensor>
        <jointpos name="angle_q_B" joint="q_B"/>
        <jointpos name="angle_q_D" joint="q_D"/>
    </sensor>

    <equality>
        <connect site1="C_site" site2="D_site" solref="0.01 1" solimp="0.9 0.95 0.001"/>
        <connect site1="G_loop_site" site2="G_site" solref="0.01 1" solimp="0.9 0.95 0.001"/>
        <tendon tendon1="t_de_abs" tendon2="t_dc_abs" solref="0.01 1" solimp="0.9 0.95 0.001"/>
        <joint joint1="q_E" joint2="q_F" polycoef="0 -1 0 0 0"/>
    </equality>

    <keyframe>
        <!-- qpos order: q_B q_BC q_C q_D q_DE q_E q_F (radians) -->
        <!-- ctrl order: act_q_B act_q_D (radians) -->
        <key name="init" qpos="-3.527 0.143 -0.083 -3.369 -0.090 0.090 -0.033" ctrl="0 0"/>
    </keyframe>

</mujoco>
